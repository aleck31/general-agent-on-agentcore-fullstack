# Per-server build/runtime config, read by scripts/build-mcp.sh.

RUNTIME_SUFFIX=google
# Image tag: no CLI to pin, so the server's own source is its identity.
IMAGE_TAG='src-$SRC_SHA'

# Skipped by a build-everything run unless Google is configured. Without a credential
# provider the runtime would list a tool nobody can call. Naming it explicitly
# (`./deploy.sh mcp google`) builds it regardless.
DEPLOY_IF=GOOGLE_CLIENT_ID

# Nothing. This server holds no credential of its own: the only thing it ever acts with is
# the caller's own Google access token, which arrives per request in a passthrough header.
# That is the point of the exercise — a second downstream system should need no new secret
# in the container, only a provider in the Token Vault.
REQUIRE_VARS=""
RUNTIME_ENV_MAP=""
